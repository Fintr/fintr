#!/usr/bin/env sh
# Shared pre-commit hook (tracked in git). Runs hooks from prek.toml.
set -e

ROOT="$(git rev-parse --show-toplevel)"
cd "${ROOT}" || exit 1

# Do not forward git's hook arguments — prek treats extra args as hook/project selectors.
if command -v mise >/dev/null 2>&1; then
  exec mise exec -- prek run --stage pre-commit
fi

if command -v prek >/dev/null 2>&1; then
  exec prek run --stage pre-commit
fi

echo "prek not found. From repo root run: bin/setup-git-hooks (requires prek: brew install prek)" >&2
exit 1
