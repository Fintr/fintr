#!/bin/bash -e

# Enable jemalloc for reduced memory usage and latency.
if [ -z "${LD_PRELOAD+x}" ]; then
    LD_PRELOAD=$(find /usr/lib -name libjemalloc.so.2 -print -quit)
    export LD_PRELOAD
fi

# If running the rails server then create or migrate existing database
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  # DISABLE_DATABASE_ENVIRONMENT_CHECK=1 ./bin/rails db:drop:primary # Apply this first as we're not sure of our migrations
  # DISABLE_DATABASE_ENVIRONMENT_CHECK=1 ./bin/rails db:drop:cache # Apply this first as we're not sure of our migrations
  
  ./bin/rails db:migrate
  # ./bin/rails db:create:primary
  # ./bin/rails db:create:cache
  # ./bin/rails db:migrate:primary
  # ./bin/rails db:migrate:cache

  # ./bin/rails db:setup
fi

exec "${@}"
