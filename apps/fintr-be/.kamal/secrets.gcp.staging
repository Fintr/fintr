DATABASE_HOST=$DATABASE_HOST
DB_BASE_URL=$DB_BASE_URL
SENTRY_DSN=$SENTRY_DSN
OPENAI_API_KEY=$OPENAI_API_KEY
OPENROUTER_API_KEY=$OPENROUTER_API_KEY
AI_VISION_PROVIDER=$AI_VISION_PROVIDER
