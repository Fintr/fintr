CLIENT_URL=$CLIENT_URL
CORS_ORIGINS=$CORS_ORIGINS
PORT=$PORT
RACK_ENV=$RACK_ENV
RAILS_ENV=$RAILS_ENV
USER_AUTH0_ID=$USER_AUTH0_ID
