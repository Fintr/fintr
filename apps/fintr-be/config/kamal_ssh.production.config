# Production VM SSH (api.fintr.ai / fintr.ai → same host).
# User comes from KAMAL_SSH_USER in deploy YAML; key from KAMAL_SSH_KEY_PATH / ssh.keys.

Host api.fintr.ai fintr.ai www.fintr.ai 34.21.206.91
  HostName %h
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes
  StrictHostKeyChecking accept-new
