# Production VM SSH (api.fintr.ai / fintr.ai → same host).
# User: KAMAL_SSH_USER in deploy YAML. Key: KAMAL_SSH_KEY_PATH (default ~/.ssh/fintr-gcp-key).

Host api.fintr.ai fintr.ai www.fintr.ai 34.21.206.91
  HostName %h
  IdentityFile ~/.ssh/fintr-gcp-key
  IdentitiesOnly yes
  StrictHostKeyChecking accept-new
