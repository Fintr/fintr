#!/usr/bin/env bash
# Google Secret Manager helpers for Kamal GCP deploys.
#
# Usage:
#   FINTR_GCP_PROJECT=my-project ./bin/kamal-gcp-secrets fetch production
#   ./bin/kamal-gcp-secrets extract production DATABASE_PASSWORD "$SECRETS"
#   eval "$(./bin/kamal-gcp-secrets export production)"
#   ./bin/kamal-gcp-secrets render-secrets production > .kamal/secrets.gcp
#   ./bin/kamal-gcp-secrets upload production .env.production
#
# GSM secret IDs: fintr-be-<environment>-<KEY> (environment: production | staging)

set -euo pipefail

app_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
secret_names_file="${app_root}/config/gcp/secret_names"

usage() {
  cat <<'EOF'
Usage:
  kamal-gcp-secrets fetch <production|staging>
  kamal-gcp-secrets extract <production|staging> <ENV_KEY> <SECRETS_BLOB>
  kamal-gcp-secrets export <production|staging>
  kamal-gcp-secrets render-secrets <production|staging>
  kamal-gcp-secrets upload <production|staging> <dotenv-file>

Environment:
  FINTR_GCP_PROJECT   GCP project ID (required)
  FINTR_GCP_ACCOUNT   gcloud account for Kamal adapter (default: default)
  GCLOUD_BIN          Path to gcloud (optional; auto-detected)
EOF
}

resolve_gcloud_bin() {
  local candidate

  if [[ -n "${GCLOUD_BIN:-}" && -x "${GCLOUD_BIN}" ]]
  then
    echo "${GCLOUD_BIN}"
    return 0
  fi

  if command -v gcloud >/dev/null 2>&1
  then
    command -v gcloud
    return 0
  fi

  for candidate in \
    "${CLOUDSDK_ROOT:+$CLOUDSDK_ROOT/bin/gcloud}" \
    "/opt/homebrew/bin/gcloud" \
    "/opt/homebrew/share/google-cloud-sdk/bin/gcloud" \
    "/opt/homebrew/Caskroom/google-cloud-sdk/latest/google-cloud-sdk/bin/gcloud" \
    "/usr/local/bin/gcloud" \
    "/usr/local/share/google-cloud-sdk/bin/gcloud" \
    "${HOME}/google-cloud-sdk/bin/gcloud"
  do
    if [[ -n "$candidate" && -x "$candidate" ]]
    then
      echo "$candidate"
      return 0
    fi
  done

  return 1
}

gcloud_install_help() {
  cat >&2 <<'EOF'
kamal-gcp-secrets: gcloud CLI not found (required for upload).

Install on macOS (Homebrew):
  brew install --cask google-cloud-sdk

Add gcloud to your PATH (zsh, one-time in ~/.zshrc):
  source "$(brew --prefix)/share/google-cloud-sdk/path.zsh.inc"

Or point at the binary explicitly:
  export GCLOUD_BIN="$(brew --prefix)/share/google-cloud-sdk/bin/gcloud"

Then authenticate:
  gcloud auth application-default login
  gcloud config set project "$FINTR_GCP_PROJECT"

Docs: https://cloud.google.com/sdk/docs/install
EOF
}

require_gcloud() {
  if ! GCLOUD_BIN="$(resolve_gcloud_bin)"
  then
    gcloud_install_help
    exit 1
  fi

  export GCLOUD_BIN
}

resolve_environment() {
  local environment="$1"

  case "$environment" in
    production)
      echo "fintr-be-production"
      ;;
    staging)
      echo "fintr-be-staging"
      ;;
    *)
      echo "kamal-gcp-secrets: environment must be production or staging" >&2
      exit 1
      ;;
  esac
}

read_secret_keys() {
  grep -v '^[[:space:]]*#' "$secret_names_file" | grep -v '^[[:space:]]*$' || true
}

gsm_secret_id() {
  local prefix="$1"
  local key="$2"

  echo "${prefix}-${key}"
}

# Load KEY=value lines from a dotenv file without tripping set -u during source.
load_dotenv_file() {
  local dotenv_file="$1"

  set +u
  set -a
  # shellcheck disable=SC1090
  source "$dotenv_file"
  set +a
  set -u
}

# Resolve values for Kamal keys that use a different name in .env.production.
lookup_dotenv_value() {
  local key="$1"
  local value="${!key:-}"

  if [[ -n "$value" ]]
  then
    printf '%s' "$value"
    return 0
  fi

  case "$key" in
    CLIENT_URL)
      value="${FRONTEND_URL:-}"
      ;;
  esac

  if [[ -n "$value" ]]
  then
    printf '%s' "$value"
    return 0
  fi

  return 1
}

# Write the latest enabled secret payload to a file (raw bytes via --out-file).
# Returns 0 on success. Sets GSM_READ_ERROR=permission_denied when IAM blocks access.
gsm_read_latest_secret_payload() {
  local gsm_id="$1"
  local project_id="$2"
  local dest="$3"
  local err_file
  local version_number

  GSM_READ_ERROR=""
  err_file="$(mktemp)"

  if "$GCLOUD_BIN" secrets versions access latest \
    --secret="$gsm_id" \
    --project="$project_id" \
    --out-file="$dest" \
    2>"$err_file"
  then
    rm -f "$err_file"
    return 0
  fi

  version_number="$("$GCLOUD_BIN" secrets versions list "$gsm_id" \
    --project="$project_id" \
    --filter="state:ENABLED" \
    --limit=1 \
    --format="value(name)" 2>/dev/null | sed -n 's|.*/versions/\([0-9][0-9]*\).*|\1|p' | head -n1)"

  if [[ -n "$version_number" ]] \
    && "$GCLOUD_BIN" secrets versions access "$version_number" \
      --secret="$gsm_id" \
      --project="$project_id" \
      --out-file="$dest" \
      2>"$err_file"
  then
    rm -f "$err_file"
    return 0
  fi

  if grep -q "secretmanager.versions.access" "$err_file" 2>/dev/null
  then
    GSM_READ_ERROR="permission_denied"
  fi

  if [[ "${KAMAL_GCP_SECRETS_VERBOSE:-}" == "1" ]] || [[ "${KAMAL_GCP_SECRETS_VERBOSE:-}" == "true" ]]
  then
    cat "$err_file" >&2
  fi

  rm -f "$err_file"
  return 1
}

# Returns: 0 = created, 1 = updated, 2 = failed, 3 = unchanged, 4 = skipped (no read access)
gsm_upload_secret_value() {
  local gsm_id="$1"
  local project_id="$2"
  local value="$3"
  local data_file
  local current_file
  data_file="$(mktemp)"

  printf '%s' "$value" >"$data_file"

  if "$GCLOUD_BIN" secrets describe "$gsm_id" --project="$project_id" &>/dev/null
  then
    current_file="$(mktemp)"

    if ! gsm_read_latest_secret_payload "$gsm_id" "$project_id" "$current_file"
    then
      if [[ "${GSM_READ_ERROR:-}" == "permission_denied" ]] \
        && [[ "${KAMAL_GCP_SECRETS_FORCE_UPDATE:-}" != "1" ]]
      then
        rm -f "$current_file" "$data_file"
        echo "kamal-gcp-secrets: skipped ${gsm_id} (no secretmanager.versions.access — cannot compare; grant roles/secretmanager.secretAccessor or set KAMAL_GCP_SECRETS_FORCE_UPDATE=1)" >&2
        return 4
      fi

      if [[ "${GSM_READ_ERROR:-}" != "permission_denied" ]]
      then
        rm -f "$current_file" "$data_file"
        return 2
      fi

      rm -f "$current_file"
    elif cmp -s "$current_file" "$data_file"
    then
      rm -f "$current_file" "$data_file"
      return 3
    else
      rm -f "$current_file"
    fi

    if "$GCLOUD_BIN" secrets versions add "$gsm_id" \
      --project="$project_id" \
      --data-file="$data_file" \
      --quiet
    then
      rm -f "$data_file"
      return 1
    fi

    rm -f "$data_file"
    return 2
  fi

  if "$GCLOUD_BIN" secrets create "$gsm_id" \
    --project="$project_id" \
    --replication-policy=automatic \
    --data-file="$data_file" \
    --quiet
  then
    rm -f "$data_file"
    return 0
  fi

  rm -f "$data_file"
  return 2
}

cmd_fetch() {
  local environment="$1"
  local prefix
  prefix="$(resolve_environment "$environment")"
  local project_id="${FINTR_GCP_PROJECT:?Set FINTR_GCP_PROJECT to your GCP project ID}"
  local account="${FINTR_GCP_ACCOUNT:-default}"
  local gsm_ids=()
  local key

  while IFS= read -r key
  do
    gsm_ids+=("$(gsm_secret_id "$prefix" "$key")")
  done < <(read_secret_keys)

  if [[ "${#gsm_ids[@]}" -eq 0 ]]
  then
    echo "kamal-gcp-secrets: no keys in ${secret_names_file}" >&2
    exit 1
  fi

  cd "$app_root"
  bundle exec kamal secrets fetch \
    --adapter=gcp \
    --account="$account" \
    --from="$project_id" \
    "${gsm_ids[@]}"
}

cmd_extract() {
  local environment="$1"
  local key="$2"
  local secrets_blob="$3"
  local prefix
  prefix="$(resolve_environment "$environment")"
  local gsm_id
  gsm_id="$(gsm_secret_id "$prefix" "$key")"

  cd "$app_root"
  bundle exec kamal secrets extract "$gsm_id" "$secrets_blob"
}

cmd_export() {
  local environment="$1"
  local secrets_blob
  secrets_blob="$(cmd_fetch "$environment")"
  local key

  while IFS= read -r key
  do
    value="$(cmd_extract "$environment" "$key" "$secrets_blob")"
    printf 'export %s=%q\n' "$key" "$value"
  done < <(read_secret_keys)
}

cmd_render_secrets() {
  local environment="$1"
  local deploy_suffix=""
  local secrets_file_suffix=""

  if [[ "$environment" == "staging" ]]
  then
    deploy_suffix=".staging"
    secrets_file_suffix=".staging"
  fi

  cat <<EOF
# Google Secret Manager (config/deploy.gcp${deploy_suffix}.yml).
# Requires: gcloud auth application-default login (or CI service account),
#   FINTR_GCP_PROJECT, and roles/secretmanager.secretAccessor on the project.
# GSM IDs: $(resolve_environment "$environment")-<KEY> — see config/gcp/secret_names.
# Regenerate: ./bin/kamal-gcp-secrets render-secrets ${environment} > .kamal/secrets.gcp${secrets_file_suffix}
# DO NOT ENTER RAW CREDENTIALS HERE!

SECRETS=\$(./bin/kamal-gcp-secrets fetch ${environment})
EOF

  while IFS= read -r key
  do
    echo "${key}=\$(./bin/kamal-gcp-secrets extract ${environment} ${key} \"\${SECRETS}\")"
  done < <(read_secret_keys)
}

cmd_upload() {
  local environment="$1"
  local dotenv_file="$2"
  local prefix
  prefix="$(resolve_environment "$environment")"
  local project_id="${FINTR_GCP_PROJECT:?Set FINTR_GCP_PROJECT to your GCP project ID}"
  local key
  local value
  local gsm_id
  local upload_status
  local created=0
  local updated=0
  local unchanged=0
  local skipped=0
  local skipped_compare=0
  local failed=0

  require_gcloud

  if [[ ! -f "$dotenv_file" ]]
  then
    echo "kamal-gcp-secrets: file not found: ${dotenv_file}" >&2
    exit 1
  fi

  load_dotenv_file "$dotenv_file"

  # Avoid set -e aborting the loop when one gcloud call fails.
  set +e

  while IFS= read -r key || [[ -n "$key" ]]
  do
    value=""

    if value="$(lookup_dotenv_value "$key")"
    then
      :
    elif [[ "$key" == "RAILS_MASTER_KEY" && -f "${app_root}/config/master.key" ]]
    then
      value="$(<"${app_root}/config/master.key")"
    fi

    if [[ -z "$value" ]]
    then
      echo "kamal-gcp-secrets: skip ${key} (unset in ${dotenv_file})" >&2
      skipped=$((skipped + 1))
      continue
    fi

    gsm_id="$(gsm_secret_id "$prefix" "$key")"
    gsm_upload_secret_value "$gsm_id" "$project_id" "$value"
    upload_status=$?

    case "$upload_status" in
      0)
        echo "kamal-gcp-secrets: created ${gsm_id}" >&2
        created=$((created + 1))
        ;;
      1)
        echo "kamal-gcp-secrets: updated ${gsm_id}" >&2
        updated=$((updated + 1))
        ;;
      3)
        echo "kamal-gcp-secrets: unchanged ${gsm_id}" >&2
        unchanged=$((unchanged + 1))
        ;;
      4)
        skipped_compare=$((skipped_compare + 1))
        ;;
      *)
        echo "kamal-gcp-secrets: failed ${gsm_id}" >&2
        failed=$((failed + 1))
        ;;
    esac
  done < <(read_secret_keys)

  set -e

  echo "kamal-gcp-secrets: finished — created ${created}, updated ${updated}, unchanged ${unchanged}, skipped_compare ${skipped_compare}, skipped ${skipped}, failed ${failed}" >&2

  if [[ "$skipped_compare" -gt 0 ]]
  then
    echo "kamal-gcp-secrets: grant roles/secretmanager.secretAccessor on project ${project_id} to compare values (or use KAMAL_GCP_SECRETS_FORCE_UPDATE=1 to upload anyway)" >&2
  fi

  if [[ "$failed" -gt 0 ]]
  then
    exit 1
  fi

  if [[ "$skipped_compare" -gt 0 ]]
  then
    exit 1
  fi
}

main() {
  local command="${1:-}"
  shift || true

  case "$command" in
    fetch)
      [[ $# -eq 1 ]] || { usage >&2; exit 1; }
      cmd_fetch "$1"
      ;;
    extract)
      [[ $# -eq 3 ]] || { usage >&2; exit 1; }
      cmd_extract "$1" "$2" "$3"
      ;;
    export)
      [[ $# -eq 1 ]] || { usage >&2; exit 1; }
      cmd_export "$1"
      ;;
    render-secrets)
      [[ $# -eq 1 ]] || { usage >&2; exit 1; }
      cmd_render_secrets "$1"
      ;;
    upload)
      [[ $# -eq 2 ]] || { usage >&2; exit 1; }
      cmd_upload "$1" "$2"
      ;;
    *)
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"
