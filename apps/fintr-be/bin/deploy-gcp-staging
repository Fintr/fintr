#!/usr/bin/env bash
# Deploy fintr-be staging to GCP (secrets from .env.staging, same as AWS).
#
# Usage (from apps/fintr-be):
#   ./bin/deploy-gcp-staging

set -euo pipefail

app_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$app_root"

config_file="config/deploy.gcp.staging.yml"

if [[ $# -eq 0 ]]
then
  exec ./bin/kamal deploy -c "$config_file"
fi

exec ./bin/kamal "$@" -c "$config_file"
