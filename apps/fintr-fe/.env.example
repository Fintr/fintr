# App — do not set NODE_ENV here; Next.js sets it per command (`next dev` vs `next build`).
# NODE_ENV=development in .env breaks `next build` / `make android-prod-apk` (/_document error).
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000

# Backend
NEXT_PUBLIC_BE_URL=http://localhost:3000

# Auth0
NEXT_PUBLIC_AUTH0_DOMAIN=your-domain.auth0.com
NEXT_PUBLIC_AUTH0_CLIENT_ID=your-client-id
NEXT_PUBLIC_AUTH0_AUDIENCE=https://api.your-domain.com

# Environment (development, staging, production)
NEXT_PUBLIC_ENVIRONMENT=development

# Sentry
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/project
SENTRY_ORG=fintr
SENTRY_PROJECT=nextjs
SENTRY_AUTH_TOKEN=your-auth-token

# Feature Flags
NEXT_PUBLIC_SHOW_V2=false
NEXT_PUBLIC_ERUDA=false
# Kirón Blogger shell ingest. Off in development (the overlay flashes and
# blocks clicks on the marketing homepage). On in production unless set false.
# NEXT_PUBLIC_KIRON_BLOGGER=true

# RevenueCat public SDK keys. The v2 secret key stays on the backend.
# Test Store key (test_...) is used until Apple and Google apps exist.
NEXT_PUBLIC_REVENUECAT_API_KEY=
NEXT_PUBLIC_REVENUECAT_APPLE_API_KEY=
NEXT_PUBLIC_REVENUECAT_GOOGLE_API_KEY=

# Capacitor
CAPACITOR_SERVER_URL=http://localhost:3000
CAPACITOR_CACHE_VERSION=

# E2E Tests
E2E_BE_URL=http://localhost:3000
PLAYWRIGHT_BASE_URL=http://localhost:5173
E2E_PERSONAL_EMAIL=miguel.dagatan@gmail.com
E2E_PERSONAL_PASSWORD=FintrPlaywright!Personal2026
