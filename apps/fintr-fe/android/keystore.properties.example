# Android Keystore Configuration
# Copy this file to keystore.properties and fill in your values
# This file is gitignored - never commit the actual keystore.properties!

# Path to your keystore file (relative to android directory)
storeFile=app/fintr-release-key.jks

# Keystore password
storePassword=your-keystore-password

# Key alias
keyAlias=fintr-key

# Key password
keyPassword=your-key-password


