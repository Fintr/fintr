# Web production (Kamal static export at fintr.ai).
# Copy to .env.production (gitignored). Do not use for Capacitor — see .env.mobile.production.example.

AUTH0_SECRET=your_auth0_secret

NEXT_PUBLIC_APP_BASE_URL=https://fintr.ai
NEXT_PUBLIC_BE_URL=https://api.fintr.ai
NEXT_PUBLIC_AUTH0_DOMAIN=your-tenant.auth0.com
NEXT_PUBLIC_AUTH0_CLIENT_ID=your_client_id
NEXT_PUBLIC_AUTH0_CLIENT_SECRET=your_client_secret
NEXT_PUBLIC_AUTH0_AUDIENCE=https://api.fintr.ai
NEXT_PUBLIC_ENVIRONMENT=production

# Kamal proxy (deploy.fe.yml) — TLS for apex + www (auto-added from FRONTEND_PROXY_HOST)
FRONTEND_PROXY_HOST=fintr.ai
# Or set explicitly: FRONTEND_PROXY_HOSTS=fintr.ai,www.fintr.ai
# Set false only for debugging without TLS
# KAMAL_PROXY_SSL is unused; deploy.fe.yml always sets proxy.ssl: true
# Cloudflare / reverse proxy in front of the VM:
KAMAL_PROXY_FORWARD_HEADERS=true

# Kamal SSH (prefer apps/fintr-be/.env.production; can duplicate here if needed)
# KAMAL_SSH_USER=miguel.dagatan
# KAMAL_SSH_KEY_PATH=~/.ssh/id_ed25519
# KAMAL_SSH_HOST=api.fintr.ai

# Optional
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SHOW_V2=
# NEXT_PUBLIC_MAINTENANCE_MODE=false
# NEXT_PUBLIC_MAINTENANCE_TITLE=
# NEXT_PUBLIC_MAINTENANCE_MESSAGE=
SENTRY_AUTH_TOKEN=
