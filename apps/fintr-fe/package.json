{
  "name": "fintr-fe-nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npx --no-install dotenv-cli -e .env -- sh -c 'if [ -z \"$$PORT\" ]; then export PORT=5173; fi; exec next dev --turbopack'",
    "dev:e2e": "npx --no-install dotenv-cli -e .env -- next dev --turbopack --hostname 127.0.0.1 --port 5173",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "build:ios": "next build && npx cap sync ios",
    "build:android": "next build && npx cap sync android",
    "ios": "npx cap open ios",
    "ios:simulator": "npx cap open ios",
    "android": "npx cap run android",
    "build:android:staging": "./build-android-staging.sh",
    "android:open": "npx cap open android",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:weekly-feedback": "vitest run src/config/weekly-feedback.test.ts src/components/feedback/weekly-feedback-ui.test.tsx src/services/product-pulse/mutations.test.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:all": "pnpm test:coverage && pnpm test:e2e",
    "test:mobile": "playwright test --project='Mobile Chrome - Small' --project='Mobile Safari - iPhone 14'"
  },
  "dependencies": {
