# Copy to .env.gcp.production (gitignored) from .env.production, then set GCP values below.
# Used by apps/fintr-be/bin/deploy-gcp-fe and config/deploy.fe.gcp.yml

# ... copy remaining keys from .env.production (Auth0, Sentry, etc.) ...

# GCP Kamal deploy (gcp.fintr.ai)
NEXT_PUBLIC_APP_BASE_URL=https://gcp.fintr.ai
NEXT_PUBLIC_BE_URL=https://api.fintr.ai
FRONTEND_PROXY_HOST=gcp.fintr.ai
KAMAL_PROXY_SSL=true

# Optional maintenance mode (non-admins blocked after login)
# NEXT_PUBLIC_MAINTENANCE_MODE=true
# NEXT_PUBLIC_MAINTENANCE_TITLE=We'll be right back
# NEXT_PUBLIC_MAINTENANCE_MESSAGE=We're preparing gcp.fintr.ai.
