# Capacitor / native app production build.
# Copy to .env.mobile.production (gitignored).
# Mobile scripts load this file — not .env.production.

AUTH0_SECRET=your_auth0_secret

# Deep-link scheme for native; build scripts may override to https://www.fintr.ai for WebView server URL
NEXT_PUBLIC_APP_BASE_URL=fintrapp://
NEXT_PUBLIC_BE_URL=https://api.fintr.ai
NEXT_PUBLIC_AUTH0_DOMAIN=your-tenant.auth0.com
NEXT_PUBLIC_AUTH0_CLIENT_ID=your_client_id
NEXT_PUBLIC_AUTH0_CLIENT_SECRET=your_client_secret
NEXT_PUBLIC_AUTH0_AUDIENCE=https://api.fintr.ai
NEXT_PUBLIC_ENVIRONMENT=production

# Optional: in-app Eruda on device
# NEXT_PUBLIC_ERUDA=true

SENTRY_AUTH_TOKEN=
